{
  "name": "sophiafx",
  "version": "0.1.0",
  "description": "Ultra-lightweight, high-performance TypeScript client and orchestrator for axAudio Discord voice engines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "axaudio",
    "discord",
    "audio",
    "music",
    "lavalink",
    "shoukaku",
    "dsp",
    "equalizer",
    "voice",
    "discord-audio",
    "sophiafx"
  ],
  "author": "Shnimlz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shnimlz/sophiafx.git"
  },
  "bugs": {
    "url": "https://github.com/Shnimlz/sophiafx/issues"
  },
  "homepage": "https://github.com/Shnimlz/sophiafx#readme",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "oxlint": "^1.88.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "peerDependenciesMeta": {
    "discord.js": {
      "optional": true
    }
  }
}
